{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aipi-remote-mcp",
  "main": "cloud/worker.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "aipi.website/oauth/consent", "zone_name": "aipi.website" },
    { "pattern": "mcp.aipi.website", "custom_domain": true }
  ],
  "vars": {
    "SUPABASE_URL": "https://zwffmaxjbzuazopvorkv.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_usDgSv1ntGAwQVpk2lenYQ_E06i1WYy",
    "GITHUB_APP_ID": "5422174",
    "GITHUB_APP_CLIENT_ID": "Iv23li3YwWzsj4VMO8EO",
    "GITHUB_APP_CALLBACK_URL": "https://app.aipi.website/team/github-callback"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PAIRING", "class_name": "PairingSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PairingSession"] }
  ]
}
