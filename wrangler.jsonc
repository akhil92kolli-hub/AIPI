{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aipi-remote-mcp",
  "main": "cloud/worker.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "PAIRING", "class_name": "PairingSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PairingSession"] }
  ]
}
