{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aipi",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "routes": [
    { "pattern": "aipi.website", "custom_domain": true },
    { "pattern": "www.aipi.website", "custom_domain": true }
  ],
  "vars": {
    "SUPABASE_URL": "https://zwffmaxjbzuazopvorkv.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_usDgSv1ntGAwQVpk2lenYQ_E06i1WYy"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
